+@keyframes packFall {
+  0% { opacity:1; transform:translateY(-85px) rotate(-6deg) scale(.20); }
+  68% { opacity:1; transform:translateY(4px) rotate(3deg) scale(.20); }
+  83% { opacity:1; transform:translateY(-5px) rotate(-2deg) scale(.20); }
+  100% { opacity:1; transform:translateY(0) rotate(0) scale(.20); }
+}
+.collect-btn { position:absolute; left:65px; top:411px; width:170px; height:72px;
+  border:0; border-radius:8px; background:transparent; cursor:pointer; }
+.collect-btn:hover, .collect-btn:focus-visible { outline:2px solid #e8c469; background:rgba(232,196,105,.10); }
+
+/* la salle d'ouverture prend exactement la place de la machine */
+.room { position:absolute; top:35px; left:0; width:300px; height:440px; background:none; border:0; border-radius:0;
+  padding:0; margin:0; opacity:0; }
