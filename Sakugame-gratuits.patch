--- /dev/null
+++ b/summon-machines/cinema-free.svg
@@ -0,0 +1,734 @@
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="portal-svg basic-machine" viewBox="0 0 300 510" width="300" height="510" role="img" aria-label="Distributeur CINÉMA — FILMS · HISTOIRES AU CINÉMA"><style><![CDATA[
+.featured-card { display:none !important; }
+
+.slot[hidden] { display:none !important; }
+.strong-machine .mpname { font-size:19px; letter-spacing:.08em; fill:#fff1d4; }
+.strong-machine .mpuni { font-size:10px; letter-spacing:.14em; fill:#d3b985; }
+.edition-card { background:#0d0c0b; border:1px solid #56472c; border-radius:16px;
+  padding:24px; display:flex; flex-direction:column; align-items:center; }
+.edition-card .portal-svg { width:min(300px,100%); height:auto; }
+.edition-card figcaption { text-align:center; color:#cbbb9c; font-size:.8rem; line-height:1.6; margin-top:12px; }
+:root { --bg:#05080f; --panel:#0a0e17; --line:rgba(255,255,255,.08); --text:#eaf2ff;
+        --muted:#7f8ea8; }
+* { box-sizing:border-box; }
+body { margin:0; background:var(--bg); color:var(--text);
+       font-family:Outfit,"Segoe UI",system-ui,-apple-system,sans-serif; padding:26px 22px 40px; }
+.wrap { max-width:1180px; margin:0 auto; }
+header { text-align:center; margin:0 0 26px; }
+h1 { font-size:1.5rem; margin:0 0 6px; letter-spacing:.4px; }
+.sub { color:var(--muted); font-size:.88rem; margin:0; line-height:1.6; }
+h2 { font-size:1.05rem; margin:0 0 4px; letter-spacing:.3px; }
+h2 small { display:block; color:var(--muted); font-size:.74rem; font-weight:600;
+  letter-spacing:.02em; margin-top:4px; }
+section { margin:0 0 30px; }
+.shead { text-align:center; margin:0 0 18px; }
+.lead { max-width:900px; margin:0 auto 20px; color:var(--muted); font-size:.82rem;
+  line-height:1.75; text-align:center; }
+.lead b { color:var(--text); }
+
+/* ---- la comparaison, gardee pour memoire ---- */
+.cmp { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:start; }
+@media (max-width:900px) { .cmp { grid-template-columns:1fr; } }
+.cell { background:var(--panel); border:1px solid var(--line); border-radius:16px;
+  padding:22px 20px; display:flex; flex-direction:column; align-items:center; }
+.cell > figcaption { margin:16px 0 0; text-align:center; }
+.cell h3 { font-size:1rem; margin:0 0 8px; }
+.cell ul { margin:0; padding:0; list-style:none; text-align:left; font-size:.78rem;
+  color:var(--muted); line-height:1.75; }
+.cell li { padding-left:16px; position:relative; }
+.cell li::before { content:"\2014"; position:absolute; left:0; color:#3d4a63; }
+.cell li b { color:var(--text); }
+.tag { display:inline-block; font:800 .62rem/1 Outfit,sans-serif; letter-spacing:.16em;
+  text-transform:uppercase; padding:5px 9px; border-radius:5px; margin:0 0 12px; }
+.tag.a { background:rgba(126,230,255,.14); color:#7ee6ff; }
+.tag.b { background:rgba(255,138,76,.14); color:#ff8a4c; }
+.tag.off { background:rgba(127,142,168,.14); color:#8fa3b8; }
+
+/* ---- la gamme ---- */
+.range { display:flex; flex-wrap:wrap; gap:20px; justify-content:center; }
+.rcell { display:flex; flex-direction:column; align-items:center; gap:10px; }
+.rcell figcaption { text-align:center; }
+.rcell .rn { font:800 .92rem/1 "Arial Narrow","Helvetica Neue Condensed",
+  "Liberation Sans Narrow",system-ui,sans-serif; letter-spacing:.5px; }
+.rcell .ru { color:var(--muted); font-size:.68rem; font-weight:700; letter-spacing:.12em;
+  text-transform:uppercase; margin-top:5px; }
+
+.portal-svg { border-radius:6px; display:block; max-width:100%; height:auto; }
+.cell .portal-svg { width:min(300px, 100%); height:auto; }
+.anat .portal-svg { width:min(560px, 100%); height:auto; }
+@media (max-width:640px) { .rcell .portal-svg { width:min(300px, 82vw); } }
+
