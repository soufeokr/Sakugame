+/* ---- la scene de convocation : une seule place, 300 x 440 ---- */
+[hidden] { display:none !important; }
+.stagewrap { position:relative; width:300px; height:510px; margin:0 auto; }
+.machine { position:absolute; inset:0; transition:opacity .42s ease, transform .42s ease; }
+.machine .portal-svg { width:100%; height:100%; display:block; }
+/* le distributeur tremble quand on appuie */
+.machine.shake { animation:mShake .68s cubic-bezier(.36,.07,.19,.97) both; }
+@keyframes mShake {
+  0%,100% { transform:translate(0,0) rotate(0); }
+  10% { transform:translate(-3px,1px) rotate(-.5deg); }
+  20% { transform:translate(4px,-2px) rotate(.6deg); }
+  30% { transform:translate(-5px,2px) rotate(-.8deg); }
+  40% { transform:translate(5px,-1px) rotate(.6deg); }
+  50% { transform:translate(-4px,2px) rotate(-.7deg); }
+  60% { transform:translate(4px,-2px) rotate(.8deg); }
+  70% { transform:translate(-3px,1px) rotate(-.5deg); }
+  80% { transform:translate(2px,-1px) rotate(.3deg); }
