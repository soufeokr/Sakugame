+.openwrap.bye { opacity:0; transform:scale(.7) translateY(-14px); }
+
+/* le bouton : la zone cliquable posee sur le bouton dessine par la machine */
+.invoke-btn { position:absolute; left:28px; top:368px; width:119px; height:30px;
