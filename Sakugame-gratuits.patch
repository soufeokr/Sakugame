+  "Liberation Sans Narrow",system-ui,sans-serif; }
+.mprate { font-size:10px; font-weight:900; font-family:Outfit,"Segoe UI",system-ui,sans-serif; }
+.mppct { fill:#c9d6ea; font-size:8px; font-weight:700;
+  font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
+.mpsm { fill:#8fa3b8; font-size:7.4px; font-weight:700; letter-spacing:.18em;
