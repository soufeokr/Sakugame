+/* Rotation automatique des cartes de la vitrine. Chaque cycle est décalé
+   d'un tiers : milieu -> gauche -> droite -> milieu. */
+ .featured-card { animation:showcaseCarousel 16s ease-in-out infinite; transform-origin:0 0; }
+.featured-0 { animation-delay:-4s; }
+.featured-1 { animation-delay:0s; }
+.featured-2 { animation-delay:-12s; }
+.featured-3 { animation-delay:-8s; }
+@keyframes showcaseCarousel {
+  0%, 12%, 100% { opacity:1; transform:translate(150px,214px) scale(.355) translate(-130px,-372px); }
+  6% { opacity:1; transform:translate(150px,212px) scale(.355) translate(-130px,-372px); }
+  18% { opacity:1; transform:translate(150px,213px) scale(.355) translate(-130px,-372px); }
+  25%, 43% { opacity:1; transform:translate(72px,214px) scale(.235) translate(-130px,-372px); }
+  49% { opacity:1; transform:translate(-35px,214px) scale(.235) translate(-130px,-372px); }
+  50% { opacity:0; transform:translate(-35px,214px) scale(.235) translate(-130px,-372px); }
+  51%, 68% { opacity:0; transform:translate(335px,214px) scale(.235) translate(-130px,-372px); }
+  69% { opacity:1; transform:translate(335px,214px) scale(.235) translate(-130px,-372px); }
+  75%, 93% { opacity:1; transform:translate(228px,214px) scale(.235) translate(-130px,-372px); }
+}
+@media (prefers-reduced-motion:reduce) {
+  .featured-card { animation:none; }
+  .featured-3 { display:none; }
+}
+/* ---- la scene de convocation : une seule place, 300 x 440 ---- */
+[hidden] { display:none !important; }
+.stagewrap { position:relative; width:300px; height:510px; margin:0 auto; }
+.machine { position:absolute; inset:0; transition:opacity .42s ease, transform .42s ease; }
+.machine .portal-svg { width:100%; height:100%; display:block; }
+/* le distributeur tremble quand on appuie */
+.machine.shake { animation:mShake .68s cubic-bezier(.36,.07,.19,.97) both; }
+@keyframes mShake {
+  0%,100% { transform:translate(0,0) rotate(0); }
+  10% { transform:translate(-3px,1px) rotate(-.5deg); }
+  20% { transform:translate(4px,-2px) rotate(.6deg); }
+  30% { transform:translate(-5px,2px) rotate(-.8deg); }
+  40% { transform:translate(5px,-1px) rotate(.6deg); }
+  50% { transform:translate(-4px,2px) rotate(-.7deg); }
+  60% { transform:translate(4px,-2px) rotate(.8deg); }
+  70% { transform:translate(-3px,1px) rotate(-.5deg); }
+  80% { transform:translate(2px,-1px) rotate(.3deg); }
+  90% { transform:translate(-1px,1px) rotate(-.2deg); }
+}
+.machine.away { opacity:0; transform:scale(.92); pointer-events:none; }
