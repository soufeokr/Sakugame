+.invoke-btn:disabled { cursor:default; }
+
+/* Le booster descend DANS la fenêtre du bac, puis attend le joueur. */
+.tray-window { position:absolute; left:65px; top:411px; width:170px; height:72px; overflow:hidden; pointer-events:none; }
+.packdrop { position:absolute; left:60px; top:0; width:238px; height:365px;
+  transform-origin:top left; opacity:0; pointer-events:none; }
+.packdrop.fall { animation:packFall .85s cubic-bezier(.22,.7,.3,1) both; }
+.tray-window.multi .packdrop { left:10px; }
+.tray-window.multi .packdrop:nth-child(2) { left:35px; }
+.tray-window.multi .packdrop:nth-child(3) { left:60px; }
+.tray-window.multi .packdrop:nth-child(4) { left:85px; }
+.tray-window.multi .packdrop:nth-child(5) { left:110px; }
+.tray-window.multi .packdrop:nth-child(2).fall { animation-delay:.24s; }
+.tray-window.multi .packdrop:nth-child(3).fall { animation-delay:.48s; }
+.tray-window.multi .packdrop:nth-child(4).fall { animation-delay:.72s; }
+.tray-window.multi .packdrop:nth-child(5).fall { animation-delay:.96s; }
+.tray-window.collecting .packdrop:not(:first-child) { opacity:0; transition:opacity .3s; animation:none; }
+.tray-window.multi .packdrop.collecting { animation-name:packCollectMulti; }
+@keyframes packCollectMulti { from { opacity:1; transform:translateY(0) scale(.20); }
+ to { opacity:1; transform:translate(-44px,-339px) scale(1); } }
+.tray-window.collecting { overflow:visible; }
+.packdrop.collecting { animation:packCollect .7s cubic-bezier(.2,.7,.25,1) forwards; }
+@keyframes packCollect { from { opacity:1; transform:translateY(0) scale(.20); }
+  to { opacity:1; transform:translate(-94px,-339px) scale(1); } }
+.quick-toggle { display:block; margin:16px auto 4px; padding:10px 16px; border-radius:9px;
