+             system-ui,sans-serif; }
+.mpclock { fill:#e8c469; font-size:15px; font-weight:800;
+  font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
+.mpcost { fill:#fff; font-size:14px; font-weight:900;
