+/* ---- la machine ---- */
+.mpname { fill:#fff; font-size:25px; font-weight:900; letter-spacing:.04em;
+  font-family:Outfit,"Segoe UI",system-ui,sans-serif; }
+.mpuni { fill:#c9d6ea; font-size:8.6px; font-weight:700; letter-spacing:.16em;
+  font-family:"Arial Narrow","Helvetica Neue Condensed","Liberation Sans Narrow",
+             system-ui,sans-serif; }
+.mplab { fill:#8fa3b8; font-size:7.6px; font-weight:700; letter-spacing:.2em;
+  text-transform:uppercase; font-family:"Arial Narrow","Helvetica Neue Condensed",
+  "Liberation Sans Narrow",system-ui,sans-serif; }
+.mprate { font-size:10px; font-weight:900; font-family:Outfit,"Segoe UI",system-ui,sans-serif; }
+.mppct { fill:#c9d6ea; font-size:8px; font-weight:700;
+  font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
+.mpsm { fill:#8fa3b8; font-size:7.4px; font-weight:700; letter-spacing:.18em;
+  font-family:"Arial Narrow","Helvetica Neue Condensed","Liberation Sans Narrow",
+             system-ui,sans-serif; }
+.mpclock { fill:#e8c469; font-size:15px; font-weight:800;
+  font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
