+  font-family:Outfit,"Segoe UI",system-ui,sans-serif; }
+
+/* ---- la boite, direction ecartee ---- */
+.bxname { fill:#fff; font-size:22px; font-weight:900; letter-spacing:.06em;
+  font-family:Outfit,"Segoe UI",system-ui,sans-serif; }
+.bxuni { fill:#c9d6ea; font-size:9px; font-weight:700; letter-spacing:.18em;
