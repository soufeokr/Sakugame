+  border-radius:10px; color:transparent; font:inherit; }
+.invoke-btn.five { left:153px; }
+.invoke-btn:hover:not(:disabled) { background:rgba(255,255,255,.11); }
+.invoke-btn:focus-visible { outline:2px solid var(--gold); outline-offset:3px; }
+.invoke-btn:disabled { cursor:default; }
+
+/* Le booster descend DANS la fenêtre du bac, puis attend le joueur. */
+.tray-window { position:absolute; left:65px; top:411px; width:170px; height:72px; overflow:hidden; pointer-events:none; }
+.packdrop { position:absolute; left:60px; top:0; width:238px; height:365px;
+  transform-origin:top left; opacity:0; pointer-events:none; }
+.packdrop.fall { animation:packFall .85s cubic-bezier(.22,.7,.3,1) both; }
+.tray-window.multi .packdrop { left:10px; }
+.tray-window.multi .packdrop:nth-child(2) { left:35px; }
+.tray-window.multi .packdrop:nth-child(3) { left:60px; }
+.tray-window.multi .packdrop:nth-child(4) { left:85px; }
+.tray-window.multi .packdrop:nth-child(5) { left:110px; }
+.tray-window.multi .packdrop:nth-child(2).fall { animation-delay:.24s; }
+.tray-window.multi .packdrop:nth-child(3).fall { animation-delay:.48s; }
+.tray-window.multi .packdrop:nth-child(4).fall { animation-delay:.72s; }
+.tray-window.multi .packdrop:nth-child(5).fall { animation-delay:.96s; }
+.tray-window.collecting .packdrop:not(:first-child) { opacity:0; transition:opacity .3s; animation:none; }
+.tray-window.multi .packdrop.collecting { animation-name:packCollectMulti; }
+@keyframes packCollectMulti { from { opacity:1; transform:translateY(0) scale(.20); }
+ to { opacity:1; transform:translate(-44px,-339px) scale(1); } }
+.tray-window.collecting { overflow:visible; }
+.packdrop.collecting { animation:packCollect .7s cubic-bezier(.2,.7,.25,1) forwards; }
+@keyframes packCollect { from { opacity:1; transform:translateY(0) scale(.20); }
+  to { opacity:1; transform:translate(-94px,-339px) scale(1); } }
+.quick-toggle { display:block; margin:16px auto 4px; padding:10px 16px; border-radius:9px;
+  border:1px solid var(--line); background:var(--panel); color:var(--text); cursor:pointer;
+  font:700 .75rem/1 Outfit,sans-serif; letter-spacing:.04em; }
+.quick-toggle[aria-pressed="true"] { border-color:#e8c469; color:#f0d79a; background:#27210f; }
+.quick-toggle:focus-visible { outline:2px solid #e8c469; outline-offset:3px; }
+.room.quick .card3d-in { transition-duration:.18s; }
+@keyframes packFall {
+  0% { opacity:1; transform:translateY(-85px) rotate(-6deg) scale(.20); }
+  68% { opacity:1; transform:translateY(4px) rotate(3deg) scale(.20); }
+  83% { opacity:1; transform:translateY(-5px) rotate(-2deg) scale(.20); }
+  100% { opacity:1; transform:translateY(0) rotate(0) scale(.20); }
+}
+.collect-btn { position:absolute; left:65px; top:411px; width:170px; height:72px;
+  border:0; border-radius:8px; background:transparent; cursor:pointer; }
+.collect-btn:hover, .collect-btn:focus-visible { outline:2px solid #e8c469; background:rgba(232,196,105,.10); }
+
+/* la salle d'ouverture prend exactement la place de la machine */
+.room { position:absolute; top:35px; left:0; width:300px; height:440px; background:none; border:0; border-radius:0;
+  padding:0; margin:0; opacity:0; }
+.room.in { animation:roomIn .4s ease both; }
+@keyframes roomIn { from { opacity:0; transform:scale(.95); }
+  to { opacity:1; transform:none; } }
+.room .board { width:300px; height:440px; margin:0; }
+.prog-out { text-align:center; margin:18px 0 0; min-height:1em;
+  font:700 .72rem/1 ui-monospace,"SF Mono",Menlo,Consolas,monospace;
+  letter-spacing:.17em; text-transform:uppercase; color:var(--muted); }
+.backbtn { display:block; margin:20px auto 0; background:var(--panel);
+  border:1px solid var(--line); color:var(--muted); border-radius:9px;
+  padding:9px 16px; font:700 .72rem/1 Outfit,sans-serif; letter-spacing:.12em;
+  text-transform:uppercase; cursor:pointer; }
+.backbtn:hover { color:var(--text); border-color:rgba(255,255,255,.2); }
+@media (max-width:400px) { body { padding:26px 8px 40px; } }
+@media (prefers-reduced-motion: reduce) {
+  .machine.shake { animation:none; }
